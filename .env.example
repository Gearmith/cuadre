# Copia este archivo como .env.local y rellena con los datos de tu proyecto Supabase
# (Supabase > Project Settings > API Keys / Data API).
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Opcional: la dirección pública de la app (para los enlaces de los correos).
# En Vercel no hace falta si configuras la Site URL en Supabase.
# NEXT_PUBLIC_SITE_URL=https://tu-app.vercel.app
